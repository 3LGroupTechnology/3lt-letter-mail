# 3L-Group Technology — AI Letter Mail production environment.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
#   cp .env.example .env
#   # edit .env, then:
#   ./deploy.sh

# --- REQUIRED ---------------------------------------------------------------
# PostGrid Print & Mail API key. Start with a TEST key (test_...);
# sends are simulated and nothing is mailed. A LIVE key (live_...)
# sends real mail and is REFUSED at startup unless ALLOW_LIVE_MAIL=1.
POSTGRID_API_KEY=test_REPLACE_ME

# Mail provider selector: "postgrid" (default) or "lob" (legacy fallback).
MAIL_PROVIDER=postgrid

# Allow live mail-provider keys (real mail). Keep 0/unset until ready.
ALLOW_LIVE_MAIL=0

# Strong secret for admin endpoints (approvals, key issuance).
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LMS_ADMIN_TOKEN=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET

# --- OPTIONAL ----------------------------------------------------------------
# Estimated PostGrid per-letter base used in quotes (PostGrid bills actuals).
POSTGRID_BASE_COST_USD=0.97

# PostGrid Address Verification API key (separate product). Leave blank
# to reuse the Print & Mail key above.
POSTGRID_AV_API_KEY=

# --- LEGACY LOB FALLBACK (only used when MAIL_PROVIDER=lob) ------------------
# Lob API key. Start with a TEST key (test_...) — sends are simulated.
LOB_API_KEY=
# Estimated Lob per-letter base used in quotes (Lob bills actuals).
LOB_BASE_COST_USD=1.08

# SQLite location inside the container (backed by the lms-data volume).
LMS_DB_PATH=/data/lms.db

# MCP server bind (inside the container).
LMS_MCP_HOST=0.0.0.0
LMS_MCP_PORT=8001

# --- BILLING (Stripe, test mode only) ----------------------------------------
# Test secret key (sk_test_...). Non-test keys are refused by the code.
STRIPE_SECRET_KEY=
# Publishable key for the /billing Payment Element page.
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret for POST /v1/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=

# --- APPROVAL LINKS ----------------------------------------------------------
# HMAC secret signing the one-tap Allow/Deny links. Generate like the admin
# token. If unset, an ephemeral one is generated (links die on restart).
APPROVAL_TOKEN_SECRET=
# Public base URL embedded in approval links sent to customers.
PUBLIC_BASE_URL=https://mail.example.com

# --- RECEIPTS ----------------------------------------------------------------
# TLT_MAILER_BACKEND=log writes itemized receipts to TLT_RECEIPTS_DIR.
TLT_MAILER_BACKEND=log
TLT_RECEIPTS_DIR=/data/receipts

# --- PDF UPLOADS -------------------------------------------------------------
# Where uploaded PDFs are stored (per-draft directories). Backed by volume.
LMS_UPLOADS_DIR=/data/uploads
# Max PDF upload size in bytes (default 10MB).
LMS_MAX_PDF_BYTES=10485760

# --- SHARED LIBRARY -----------------------------------------------------------
# Path INSIDE the container to the 3lt-shared/ library (tlt_risk, tlt_billing,
# tlt_tiers, ...). The 3lt-shared/ directory must be inside the Docker build
# context (i.e. copied into letter-mail-service/ before building).
TLT_SHARED_DIR=/app/3lt-shared
